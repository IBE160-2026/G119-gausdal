// AD-3: PostgreSQL med Prisma. Datamodellen eies av denne filen og endres
// bare via migreringer. User/Session/Account/Verification er generert av
// `npx auth@1.7.28 generate` mot src/app/auth.ts (Better Auth, Story 1.3) —
// ikke håndskrevet. Kjør samme kommando på nytt hvis auth.ts endres.
// Senere historiers domenetabeller legges til i egne migreringer.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: tilkoblingsstrengen leses i prisma.config.ts, ikke her.

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  // Story 1.4: håndlagte back-relation-felt. better-auths Prisma-generator
  // (npx auth generate) oppdager og bevarer disse ved en senere re-kjøring
  // (PR better-auth/better-auth#12896, inkludert i better-auth@1.7.28 — se
  // spec-1-4 Boundaries).
  brukerKort    BrukerKort[]
  brukerProfil  BrukerProfil?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Story 1.4: kortkatalog (seedet, ikke brukerredigerbar). Stabilt `kode`-felt
// for seed/oppslag i tillegg til UUID `id` (AD-konvensjon).
model Kort {
  id         String       @id @default(uuid())
  kode       String       @unique
  navn       String
  brukerKort BrukerKort[]

  @@map("kort")
}

// Story 1.4: hvilke kort brukeren har valgt. Erstattes helt (ikke merges) ved
// ny lagring fra oppsett — se spec-1-4 Boundaries/Edge-Case Matrix.
model BrukerKort {
  id        String   @id @default(uuid())
  brukerId  String
  bruker    User     @relation(fields: [brukerId], references: [id], onDelete: Cascade)
  kortId    String
  kort      Kort     @relation(fields: [kortId], references: [id])
  createdAt DateTime @default(now())

  @@unique([brukerId, kortId])
  @@map("bruker_kort")
}

// Story 1.4: Trumf/SkyTeam-svarene fra oppsett. Utvidet av Story 1.5 med
// mål- og startverdier-feltene (se spec-1-5 Code Map) — alle valgfrie siden
// raden opprettes i Story 1.4s steg, før disse feltene er kjent, og fylles
// inn ved en senere `update` (ikke `upsert`) fra /oppsett/mal.
model BrukerProfil {
  id          String   @id @default(uuid())
  brukerId    String   @unique
  bruker      User     @relation(fields: [brukerId], references: [id], onDelete: Cascade)
  trumfKoblet Boolean
  kunSas      Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Story 1.5 (FR-3, FR-6): poengmål, valgfritt siden raden kan finnes før
  // dette steget er fullført. `null` betyr «oppsett ikke fullført» — brukt
  // av (app)/layout.tsx til å avgjøre redirect.
  poengmal Int?

  // Story 1.5 (FR-2): bare sanne hvis brukeren faktisk har riktig kort
  // (Amex Elite / Mastercard Premium) — revalidert server-side ved lagring.
  harCompanionTicket Boolean @default(false)
  harFlyPremium      Boolean @default(false)

  // Story 1.5 (FR-4, AR-5): startverdier. Poeng som rene heltall; beløp som
  // heltall i øre (AD-5-konvensjonen for beløp, gjenbrukt her for inntasting).
  bonuspoengIDag       Int?
  bonuspoengSiste12Mnd Int?
  amexForbrukOre       Int?
  trumfKronerOre       Int?

  @@map("bruker_profil")
}
