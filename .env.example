# AD-10: Alle miljøvariabler appen leser, uten verdier. Kopier til `.env`
# lokalt ved behov — `.env` er i .gitignore og skal aldri committes.
# `docker compose up` setter disse selv og trenger ikke denne filen.

# AD-3: tilkoblingsstreng til PostgreSQL (postgresql://bruker:passord@host:5432/database)
DATABASE_URL=

# AD-9: mappe for lokal fillagring. Valgfri — standard er ./storage.
STORAGE_DIR=
